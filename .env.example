# Discord
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here

# Webhook for admin alerts (create in Discord channel settings)
ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/filmreel

# Redis / Upstash (for BullMQ and caching)
# Provide either REDIS_URL or UPSTASH_REDIS_REST_URL
REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=rediss://default:<token>@<host>.upstash.io:6379
# Use non-default Redis DB index (range: 1-15, default: 1)
# REDIS_DB_INDEX=1

# TMDB API
TMDB_API_KEY=your_tmdb_api_key_here

# Guild IDs (comma-separated for development)
GUILD_IDS=123456789012345678,876543210987654321

# Environment
NODE_ENV=development
# Automatically run `prisma migrate deploy` on service startup (1=true, 0=false)
AUTO_MIGRATE=1

# Scraping settings
SCRAPE_CONCURRENCY=2
TMDB_CACHE_TTL_DAYS=14
SCRAPE_COOLDOWN_MINUTES=60
# Enable verbose scraper logs (1=true, 0=false)
SCRAPER_DEBUG=0

# Worker concurrency (optional, defaults: 5, 10)
# FILM_RESOLUTION_CONCURRENCY=5
# XP_WORKER_CONCURRENCY=10

# Bot pagination default page size (optional, default: 10, range: 1-100)
# PAGINATION_DEFAULT_PAGE_SIZE=10

# Scheduler health check delay in ms (optional, default: 60000)
# HEALTH_CHECK_DELAY_MS=60000
# Scheduler distributed lock ttl in ms (optional, default: 7200000)
# SCHEDULER_LOCK_TTL_MS=7200000

# Film resolution job retries (optional, defaults: 3 attempts, 24h backoff)
# FILM_RESOLUTION_ATTEMPTS=3
# FILM_RESOLUTION_BACKOFF_MS=86400000
